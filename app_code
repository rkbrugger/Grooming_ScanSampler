  const all = [];
  state.sessions.forEach(s=> s.events.forEach(e=> all.push({s,e})));
  all.sort((a,b)=> a.e.time.localeCompare(b.e.time));

  const rows = all.length ? all.map(({s,e})=>`
    <tr>
      <td>${esc(s.species)}</td>
      <td>${esc(s.group)}</td>
