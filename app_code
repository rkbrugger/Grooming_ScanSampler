      <td class="num">${e.scan}</td>
      <td>${e.type==="dyadic"?'<span class="pill dy">dyadic</span>':'<span class="pill po">poly</span>'}</td>
      <td>${e.type==="polyadic"?(e.subtype==="chain"?"chain":"cluster"):"—"}</td>
      <td class="num">${e.type==="dyadic"?2:(e.size||"—")}</td>
      <td class="mini">${esc(e.participants)||"—"}</td>
