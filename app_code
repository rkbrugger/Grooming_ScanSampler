  const t = totals(s);
  const scanEvents = s.events.filter(e=>e.scan===s.currentScan);

  app.innerHTML = `
    <div class="card">
      <div class="sess-banner">
        <div>
          <div class="sess-id"><span class="sp">${esc(s.species)}</span>${s.group&&s.group!==s.species?'<span class="gp">'+esc(s.group)+'</span>':''}</div>
          <div class="sess-meta">${s.observer?("Observer <b>"+esc(s.observer)+"</b> · "):""}<b>${esc(s.date)}</b>${s.notes?(" · "+esc(s.notes)):""}</div>
        </div>
        <div class="sess-clock">
          <div class="clk-lbl">Session time</div>
          <div class="clock-face ${s.runningSince?"run":""}"><span class="dot"></span><span id="sessClock">${fmtDur(sessElapsed(s))}</span></div>
          <div class="btn-row">
            <button class="btn small" data-action="sess-toggle">${s.runningSince?"Pause":"Resume"}</button>
            <button class="btn ghost small" data-action="switch-session">Switch</button>
            <button class="btn small" data-action="end-session">End session</button>
          </div>
        </div>
      </div>

      <div class="divider"></div>

      <div class="console">
        <div class="scan-read">
          <div class="lbl">Scan</div>
          <div class="num" id="scanNum">${s.currentScan}</div>
        </div>
        <div class="scan-ctrls">
          <button class="btn accent" data-action="next-scan">Next scan &rarr;</button>
          <div class="scan-note"><b>${scanEvents.length}</b> grooming ${scanEvents.length===1?"bout":"bouts"} logged this scan. Record every bout you see now, then advance. A scan with none is still valid data.</div>
        </div>
      </div>

      <div class="timer" id="timerPanel"></div>
    </div>

    ${censusCard("start", s)}

    <div class="card">
      <h2>Log a grooming bout — tap once per bout observed</h2>
      <div class="log-grid">
        <button class="logbtn dy" data-action="log" data-type="dyadic">
          <span class="ico">${ICON.dyadic}</span>
          <span class="t">Dyadic</span>
          <span class="s">Two individuals</span>
          <span class="tally">SESSION <b>${t.dyadic}</b></span>
        </button>
        <button class="logbtn po${armed&&armed.subtype==="cluster"?" armed":""}" data-action="arm" data-sub="cluster">
          <span class="ico">${ICON.cluster}</span>
          <span class="t">Polyadic · Cluster</span>
          <span class="s">3+ converging on one</span>
          <span class="tally">SESSION <b>${t.cluster}</b></span>
        </button>
        <button class="logbtn po${armed&&armed.subtype==="chain"?" armed":""}" data-action="arm" data-sub="chain">
          <span class="ico">${ICON.chain}</span>
          <span class="t">Polyadic · Chain</span>
          <span class="s">3+ in a line, A&ndash;B&ndash;C</span>
          <span class="tally">SESSION <b>${t.chain}</b></span>
        </button>
      </div>
      ${armed ? armPicker() : ""}

      <div style="margin-top:14px">
        <div class="k" style="font-size:12.5px;color:var(--ink-soft);font-weight:600;margin-bottom:7px">This scan (#${s.currentScan})</div>
        <div class="chips" id="chips">
          ${scanEvents.length ? scanEvents.map(chip).join("") : '<span class="empty-scan">No grooming logged yet for this scan.</span>'}
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Session tallies</h2>
      <div class="tallies">
        <div class="tally-cell"><div class="k">Scans</div><div class="v">${t.scans}</div></div>
        <div class="tally-cell dyv"><div class="k">Dyadic</div><div class="v">${t.dyadic}</div></div>
        <div class="tally-cell pov"><div class="k">Polyadic</div><div class="v">${t.polyadic}</div><div class="sub">${t.cluster} cluster · ${t.chain} chain</div></div>
        <div class="tally-cell"><div class="k">Total bouts</div><div class="v">${t.events}</div></div>
      </div>
    </div>

    ${censusCard("end", s)}

    ${s.events.length ? sessionLog(s) : ""}
  `;
}

function chip(e){
  const cls = e.type==="dyadic" ? "dy":"po";
  const label = e.type==="dyadic" ? "Dyadic" : ("Poly · "+(e.subtype==="chain"?"chain":"cluster")+" &times;"+(e.size||"?"));
  return `<span class="chip ${cls}">${label}<button class="x" data-action="rm" data-id="${e.id}" aria-label="Remove">&times;</button></span>`;
}

function censusCard(phase, s){
  const c = s.census[phase], sizes = c.sizes;
  const n = sizes.length, total = sizes.reduce((a,b)=>a+(parseInt(b,10)||0),0);
  const editing = censusEdit[phase];
  const title = phase==="start" ? "Start-of-session census" : "End-of-session census";
  const sub = phase==="start" ? "subgroups present at the start" : "subgroups present at the end";

  if(!editing && n>0){
    return `<div class="card"><div class="census-sum">
      <div>
        <div class="census-head">${title}</div>
        <div class="big"><b>${n}</b> subgroup${n===1?"":"s"} · <b>${total}</b> individuals <span class="faint">(sizes: ${sizes.join(", ")})</span></div>
      </div>
      <button class="btn small" data-action="census-edit" data-phase="${phase}">Edit</button>
    </div></div>`;
  }
  if(!editing && n===0){
    return `<div class="card"><div class="census-sum">
      <div>
        <div class="census-head">${title} <span class="faint">${sub}</span></div>
        <div class="census-tot">Not recorded yet.</div>
      </div>
      <button class="btn small ${phase==="start"?"primary":""}" data-action="census-edit" data-phase="${phase}">Record census</button>
    </div></div>`;
  }
  // editor
  const rows = sizes.map((sz,i)=>`
    <div class="subrow">
      <span class="lab">Subgroup ${i+1}</span>
      <input type="number" min="1" step="1" inputmode="numeric" data-census="${phase}" data-idx="${i}" value="${sz}">
      <span class="faint" style="font-size:12px">individuals</span>
      <button class="icobtn" data-action="census-del" data-phase="${phase}" data-idx="${i}" aria-label="Remove subgroup">&times;</button>
    </div>`).join("");
  return `<div class="card"${phase==="end"?' id="endCensus"':''}>
    <div class="census-head">${title} <span class="faint">${sub}</span></div>
    <div class="subrows">${rows || '<div class="census-tot" style="margin:6px 0">No subgroups yet — add one for each cluster of animals you can see.</div>'}</div>
    ${n>0?`<div class="census-tot"><b>${n}</b> subgroup${n===1?"":"s"} · <b>${total}</b> individuals total</div>`:""}
    <div class="btn-row" style="margin-top:12px">
      <button class="btn small" data-action="census-add" data-phase="${phase}">+ Add subgroup</button>
      ${n>0
        ? `<button class="btn small primary" data-action="census-done" data-phase="${phase}">Done</button>`
        : `<button class="btn small ghost" data-action="census-done" data-phase="${phase}">Later</button>`}
    </div>
  </div>`;
}

function armPicker(){
  const st = armed.subtype, name = st==="chain" ? "chain" : "cluster";
  const nums = [3,4,5,6,7,8].map(n=>`<button class="numbtn" data-action="arm-log" data-size="${n}">${n}</button>`).join("");
  return `
    <div class="arm">
      <div class="arm-q"><span class="ico">${st==="chain"?ICON.chain:ICON.cluster}</span>How many individuals in this ${name}?</div>
      <div class="arm-nums">${nums}</div>
      <div class="arm-more">
        <span class="lbl">more:</span>
        <span class="stepper"><button data-action="arm-dec" aria-label="Fewer">&minus;</button><span class="sv">${armed.size}</span><button data-action="arm-inc" aria-label="More">+</button></span>
        <button class="btn primary small" data-action="arm-log" data-size="${armed.size}">Log ${name} of ${armed.size}</button>
        <button class="btn ghost small" data-action="arm-cancel">Cancel</button>
      </div>
    </div>`;
}

function sessionLog(s){
  const rows = [...s.events].sort((a,b)=> a.scan-b.scan || a.time.localeCompare(b.time)).map(e=>`
    <tr>
      <td class="num">${e.scan}</td>
      <td>${e.type==="dyadic"?'<span class="pill dy">dyadic</span>':'<span class="pill po">poly · '+(e.subtype==="chain"?"chain":"cluster")+'</span>'}</td>
      <td>${e.type==="polyadic"
          ? '<input class="icell szcell" type="number" min="3" step="1" data-edit="size" data-id="'+e.id+'" value="'+(e.size||3)+'">'
          : '<span class="mini">2</span>'}</td>
      <td class="mini">${fmtClock(e.time)}</td>
      <td><input class="icell" data-edit="participants" data-id="${e.id}" value="${esc(e.participants)}" placeholder="e.g. AB, CD or A&gt;B"></td>
      <td><input class="icell" data-edit="notes" data-id="${e.id}" value="${esc(e.notes)}" placeholder="note"></td>
      <td><button class="icobtn" data-action="rm" data-id="${e.id}" aria-label="Delete">&times;</button></td>
    </tr>`).join("");
  return `
    <div class="card flush">
      <div style="padding:14px 16px 0"><h2 style="margin:0">Full session log <span class="faint">(${s.events.length})</span></h2>
      <p class="hint" style="margin:6px 0 0">Participant IDs and notes are optional. Everything here goes into the CSV export.</p></div>
      <div class="tbl-scroll" style="margin-top:12px">
        <table>
          <thead><tr><th class="num">Scan</th><th>Type</th><th>Size</th><th>Time</th><th>Participants</th><th>Notes</th><th></th></tr></thead>
          <tbody>${rows}</tbody>
        </table>
      </div>
    </div>`;
}

function renderStart(){
  const species = state.species.filter(x=>x && x.trim());
  const paused = state.sessions;
  app.innerHTML = `
    <div class="card">
      <h2>Start an observation session</h2>
      ${species.length ? `
        <div class="form-2">
          <label class="fld"><span>Species</span>
            <select id="f-species">${species.map(sp=>`<option value="${esc(sp)}">${esc(sp)}</option>`).join("")}</select>
          </label>
          <label class="fld"><span>Group <span class="faint">(from species)</span></span>
            <input type="text" id="f-group-echo" value="${esc(groupLabelFor(species[0]))}" readonly tabindex="-1" aria-readonly="true" style="background:var(--surface-2); color:var(--ink-soft); cursor:default">
          </label>
          <label class="fld"><span>Observer <span class="faint">(optional)</span></span>
            <input type="text" id="f-observer" placeholder="Your initials" autocomplete="off">
          </label>
          <label class="fld"><span>Date</span>
            <input type="date" id="f-date" value="${todayStr()}">
          </label>
        </div>
        <label class="fld"><span>Session notes <span class="faint">(optional)</span></span>
          <input type="text" id="f-notes" placeholder="Weather, location, start time…" autocomplete="off">
        </label>
        <button class="btn primary" data-action="start-session">Start session</button>
        <p class="hint">One group per species — set group names in <b>Settings</b>. You'll record <b>multiple sessions per species</b> (one observation bout each); the Summary pools every session for a species together. Use <b>Next scan</b> to step through your scan intervals.</p>
      ` : `
        <p class="muted">No species are set up yet. Add your three species in <b>Settings</b> first.</p>
        <button class="btn primary" data-action="goto-settings">Go to settings</button>
      `}
    </div>

    ${paused.length ? `
    <div class="card flush">
      <div style="padding:14px 16px 0"><h2 style="margin:0">Resume a session <span class="faint">(${paused.length})</span></h2></div>
      <div class="sess-list" style="padding:12px 16px 16px">
        ${paused.map(s=>{const t=totals(s);return `
          <div class="sess-item">
            <div class="info">
              <div class="l1">${esc(s.species)}${s.group && s.group!==s.species ? ' · <span class="gp">'+esc(s.group)+'</span>' : ''}</div>
              <div class="l2">${esc(s.date)} · ${t.scans} scans · ${t.dyadic} dy / ${t.polyadic} poly</div>
            </div>
            <div class="row-actions">
              <button class="btn small" data-action="resume" data-id="${s.id}">Resume</button>
              <button class="icobtn" data-action="del-session" data-id="${s.id}" aria-label="Delete session">&times;</button>
            </div>
          </div>`;}).join("")}
      </div>
    </div>` : ""}
  `;
  const sel = $("#f-species");
  if(sel) sel.addEventListener("change", e=>{ const ec=$("#f-group-echo"); if(ec) ec.value = groupLabelFor(e.target.value); });
}

/* ---------- Summary ---------- */
function renderSummary(){
  const rows = groupSummary();
  if(!rows.length){ app.innerHTML = emptyCard("No data yet","Start recording on the Record tab. Per-species counts of dyadic and polyadic grooming will appear here."); return; }
  const grand = rows.reduce((a,g)=>{a.sessions+=g.sessions;a.scans+=g.scans;a.events+=g.events;a.dyadic+=g.dyadic;a.cluster+=g.cluster;a.chain+=g.chain;a.clSum+=g.clSum;a.clN+=g.clN;a.chSum+=g.chSum;a.chN+=g.chN;return a;},{sessions:0,scans:0,events:0,dyadic:0,cluster:0,chain:0,clSum:0,clN:0,chSum:0,chN:0});
  const showGroup = state.groups.some(x=>x && String(x).trim());
  const meanSub = (sum,n)=> n ? '<div class="mini">avg '+fmtMean(mean(sum,n))+'</div>' : "";

  const body = rows.map(g=>`
    <tr>
      <td><b>${esc(g.species)}</b></td>
      ${showGroup?`<td>${esc(g.group)}</td>`:""}
      <td class="num">${g.sessions}</td>
      <td class="num">${g.scans}</td>
      <td class="num">${g.dyadic}</td>
      <td class="num">${g.cluster+g.chain}</td>
      <td class="num">${g.cluster}${meanSub(g.clSum,g.clN)}</td>
      <td class="num">${g.chain}${meanSub(g.chSum,g.chN)}</td>
      <td class="num">${g.events}</td>
    </tr>`).join("");

  const totalRow = `<tr class="grp-total"><td>All species</td>${showGroup?"<td></td>":""}<td class="num">${grand.sessions}</td><td class="num">${grand.scans}</td><td class="num">${grand.dyadic}</td><td class="num">${grand.cluster+grand.chain}</td><td class="num">${grand.cluster}${meanSub(grand.clSum,grand.clN)}</td><td class="num">${grand.chain}${meanSub(grand.chSum,grand.chN)}</td><td class="num">${grand.events}</td></tr>`;

  app.innerHTML = `
    <div class="card">
      <h2>Grand totals — all species</h2>
      <div class="tallies">
        <div class="tally-cell dyv"><div class="k">Dyadic bouts</div><div class="v">${grand.dyadic}</div></div>
        <div class="tally-cell pov"><div class="k">Polyadic bouts</div><div class="v">${grand.cluster+grand.chain}</div><div class="sub">${grand.cluster} cluster (avg ${fmtMean(mean(grand.clSum,grand.clN))}) · ${grand.chain} chain (avg ${fmtMean(mean(grand.chSum,grand.chN))})</div></div>
        <div class="tally-cell"><div class="k">Scans</div><div class="v">${grand.scans}</div></div>
        <div class="tally-cell"><div class="k">Total bouts</div><div class="v">${grand.events}</div></div>
      </div>
      <p class="hint">Counts are pooled per species across all its sessions (one group per species). “Scans” is the total number of scan points taken — divide bouts by scans for a rate per scan. “avg” is the mean number of individuals per cluster or chain.</p>
    </div>

    <div class="card flush">
      <div style="padding:14px 16px 0"><h2 style="margin:0">Per species</h2></div>
      <div class="tbl-scroll" style="margin-top:12px">
        <table>
          <thead><tr><th>Species</th>${showGroup?"<th>Group</th>":""}<th class="num">Sess.</th><th class="num">Scans</th><th class="num">Dyadic</th><th class="num">Polyadic</th><th class="num">— cluster</th><th class="num">— chain</th><th class="num">Bouts</th></tr></thead>
          <tbody>${body}${totalRow}</tbody>
        </table>
      </div>
    </div>
  `;
}

/* ---------- Data & export ---------- */
