<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Grooming Scan Sampler</title>
<style>
  :root{
    --bg:#E4E6E0; --surface:#F5F6F2; --surface-2:#EAECE5; --raise:#FBFBF8;
    --ink:#1C2321; --ink-soft:#5A635D; --ink-faint:#8A928C; --line:#CBCFC6; --line-strong:#B4BAB0;
    --dyadic:#1E6B6E; --dyadic-bg:#D5E6E5; --dyadic-line:#8FC4C1;
    --polyadic:#B06713; --polyadic-bg:#F0E1C7; --polyadic-line:#DDB877;
    --danger:#A63A2C; --danger-bg:#F0D9D4;
    --ok:#2E7D46;
    --shadow:0 1px 0 rgba(28,35,33,.04), 0 6px 22px -14px rgba(28,35,33,.28);
    --mono:ui-monospace,"SF Mono",SFMono-Regular,Menlo,Consolas,"Roboto Mono",monospace;
    --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,system-ui,sans-serif;
    --r:14px; --r-sm:9px;
  }
  @media (prefers-color-scheme:dark){
    :root:not([data-theme="light"]){
      --bg:#111614; --surface:#191F1C; --surface-2:#212824; --raise:#1F2622;
      --ink:#E7EBE5; --ink-soft:#9AA39C; --ink-faint:#6C756E; --line:#2E3733; --line-strong:#3C453F;
      --dyadic:#57B7AB; --dyadic-bg:#122E2B; --dyadic-line:#2C5551;
      --polyadic:#DA9C4B; --polyadic-bg:#33260E; --polyadic-line:#5B4A26;
      --danger:#E37D6E; --danger-bg:#331A16;
      --ok:#5FB87A;
      --shadow:0 1px 0 rgba(0,0,0,.2), 0 10px 30px -18px rgba(0,0,0,.7);
    }
  }
  :root[data-theme="dark"]{
    --bg:#111614; --surface:#191F1C; --surface-2:#212824; --raise:#1F2622;
    --ink:#E7EBE5; --ink-soft:#9AA39C; --ink-faint:#6C756E; --line:#2E3733; --line-strong:#3C453F;
    --dyadic:#57B7AB; --dyadic-bg:#122E2B; --dyadic-line:#2C5551;
    --polyadic:#DA9C4B; --polyadic-bg:#33260E; --polyadic-line:#5B4A26;
    --danger:#E37D6E; --danger-bg:#331A16;
    --ok:#5FB87A;
    --shadow:0 1px 0 rgba(0,0,0,.2), 0 10px 30px -18px rgba(0,0,0,.7);
  }

  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    background:var(--bg); color:var(--ink); font-family:var(--sans);
    font-size:16px; line-height:1.45; -webkit-font-smoothing:antialiased;
    padding-bottom:env(safe-area-inset-bottom);
  }
  .wrap{max-width:860px; margin:0 auto; padding:0 16px 72px}

  /* Header */
  header.top{
    position:sticky; top:0; z-index:20; background:color-mix(in srgb,var(--bg) 88%, transparent);
    backdrop-filter:saturate(1.2) blur(8px); -webkit-backdrop-filter:saturate(1.2) blur(8px);
    border-bottom:1px solid var(--line);
  }
  .top-inner{max-width:860px; margin:0 auto; padding:12px 16px 0}
  .brand{display:flex; align-items:center; gap:11px; justify-content:space-between}
  .brand h1{
    font-size:17px; font-weight:650; letter-spacing:-.015em; margin:0; display:flex; align-items:center; gap:9px;
  }
  .brand h1 .glyph{color:var(--dyadic)}
  .theme-btn{
    border:1px solid var(--line); background:var(--surface); color:var(--ink-soft);
    width:36px; height:36px; border-radius:9px; cursor:pointer; display:grid; place-items:center;
    font-size:15px;
  }
  .theme-btn:hover{border-color:var(--line-strong); color:var(--ink)}
  nav.tabs{display:flex; gap:2px; margin-top:10px; overflow-x:auto; scrollbar-width:none}
  nav.tabs::-webkit-scrollbar{display:none}
  .tab{
    appearance:none; border:0; background:transparent; color:var(--ink-soft);
    font-family:inherit; font-size:14.5px; font-weight:550; padding:9px 13px 12px; cursor:pointer;
    border-bottom:2px solid transparent; white-space:nowrap; letter-spacing:-.01em;
  }
  .tab[aria-selected="true"]{color:var(--ink); border-bottom-color:var(--dyadic)}
  .tab:hover{color:var(--ink)}

  /* Cards */
  .card{
    background:var(--surface); border:1px solid var(--line); border-radius:var(--r);
    padding:16px; margin-top:14px; box-shadow:var(--shadow);
  }
  .card.flush{padding:0; overflow:hidden}
  .card h2{font-size:13px; font-weight:600; letter-spacing:.01em; color:var(--ink-soft); margin:0 0 12px; text-transform:none}
  .muted{color:var(--ink-soft)}
  .faint{color:var(--ink-faint)}

  /* Session banner */
  .sess-banner{display:flex; align-items:flex-start; justify-content:space-between; gap:12px; flex-wrap:wrap}
  .sess-id{display:flex; align-items:baseline; gap:8px; flex-wrap:wrap}
  .sess-id .sp{font-weight:650; font-size:19px; letter-spacing:-.02em}
  .sess-id .gp{font-weight:550; font-size:19px; letter-spacing:-.02em; color:var(--dyadic)}
  .sess-meta{font-size:13px; color:var(--ink-soft); margin-top:2px}
  .sess-meta b{font-weight:600; color:var(--ink)}

  /* Scan console */
  .console{
    display:grid; grid-template-columns:auto 1fr; gap:16px; align-items:center;
  }
  .scan-read{
    background:var(--raise); border:1px solid var(--line); border-radius:12px; padding:12px 18px; text-align:center; min-width:118px;
  }
  .scan-read .lbl{font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-faint); font-weight:600}
  .scan-read .num{font-family:var(--mono); font-size:44px; line-height:1; font-weight:600; letter-spacing:-.03em; margin-top:3px}
  .scan-ctrls{display:flex; flex-direction:column; gap:9px; min-width:0}
  .scan-note{font-size:13px; color:var(--ink-soft)}
  .scan-note b{color:var(--ink); font-weight:600}

  /* Timer */
  .timer{border-top:1px dashed var(--line); margin-top:16px; padding-top:14px}
  .timer-head{display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap}
  .timer-face{font-family:var(--mono); font-size:26px; font-weight:600; letter-spacing:-.02em; font-variant-numeric:tabular-nums}
  .timer-bar{height:6px; border-radius:99px; background:var(--surface-2); overflow:hidden; margin-top:10px}
  .timer-bar > i{display:block; height:100%; background:var(--dyadic); width:0%; transition:width .28s linear}
  .timer-row{display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:12px}
  .timer-set{display:flex; align-items:center; gap:6px; font-size:13px; color:var(--ink-soft)}
  .timer-set input{width:64px}
  .chk{display:inline-flex; align-items:center; gap:7px; font-size:13px; color:var(--ink-soft); cursor:pointer; user-select:none}
  .chk input{width:16px; height:16px; accent-color:var(--dyadic)}
  @keyframes flashdue{0%,100%{background:var(--surface)}35%{background:var(--dyadic-bg)}}
  .card.due{animation:flashdue 1s ease 2}

  /* Log buttons */
  .log-grid{display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px}
  @media (max-width:560px){ .log-grid{grid-template-columns:1fr} }
  .logbtn{
    appearance:none; cursor:pointer; text-align:left; font-family:inherit;
    border:1.5px solid var(--line); background:var(--raise); color:var(--ink);
    border-radius:12px; padding:15px 15px 13px; display:flex; flex-direction:column; gap:10px;
    transition:transform .06s ease, border-color .12s ease, background .12s ease;
  }
  .logbtn:active{transform:translateY(1px) scale(.995)}
  .logbtn .ico{width:38px; height:24px}
  .logbtn .t{font-weight:640; font-size:16px; letter-spacing:-.01em; line-height:1.1}
  .logbtn .s{font-size:12.5px; color:var(--ink-soft); line-height:1.25}
  .logbtn .tally{margin-top:auto; font-family:var(--mono); font-size:12px; color:var(--ink-faint); font-weight:600}
  .logbtn.dy{border-color:var(--dyadic-line)} .logbtn.dy:hover{background:var(--dyadic-bg)}
  .logbtn.dy .ico{color:var(--dyadic)} .logbtn.dy .tally b{color:var(--dyadic)}
  .logbtn.po{border-color:var(--polyadic-line)} .logbtn.po:hover{background:var(--polyadic-bg)}
  .logbtn.po .ico{color:var(--polyadic)} .logbtn.po .tally b{color:var(--polyadic)}

  /* Current scan chips */
  .chips{display:flex; flex-wrap:wrap; gap:7px; margin-top:4px; min-height:2px}
  .chip{
    display:inline-flex; align-items:center; gap:7px; padding:5px 6px 5px 10px; border-radius:99px;
    font-size:12.5px; font-weight:600; border:1px solid var(--line); background:var(--raise);
    animation:pop .18s ease;
  }
  @keyframes pop{from{transform:scale(.82); opacity:0}to{transform:scale(1); opacity:1}}
  .chip.dy{background:var(--dyadic-bg); border-color:var(--dyadic-line); color:var(--dyadic)}
  .chip.po{background:var(--polyadic-bg); border-color:var(--polyadic-line); color:var(--polyadic)}
  .chip .x{
    width:18px; height:18px; border-radius:99px; border:0; cursor:pointer; display:grid; place-items:center;
    background:color-mix(in srgb,currentColor 16%, transparent); color:inherit; font-size:12px; line-height:1;
  }
  .chip .x:hover{background:color-mix(in srgb,currentColor 30%, transparent)}
  .empty-scan{font-size:13px; color:var(--ink-faint); font-style:italic; padding:2px 0}

  /* Polyadic size picker */
  .logbtn.armed{background:var(--polyadic-bg); border-color:var(--polyadic); box-shadow:inset 0 0 0 1px var(--polyadic)}
  .arm{margin-top:12px; border:1.5px solid var(--polyadic-line); background:var(--polyadic-bg); border-radius:12px; padding:13px 14px; animation:pop .16s ease}
  .arm-q{font-size:14.5px; font-weight:650; color:var(--polyadic); margin-bottom:11px; display:flex; align-items:center; gap:9px; letter-spacing:-.01em}
  .arm-q .ico{width:32px; height:19px; flex:none}
  .arm-nums{display:flex; flex-wrap:wrap; gap:8px}
  .numbtn{appearance:none; cursor:pointer; font-family:var(--mono); font-weight:600; font-size:17px; min-width:46px; height:46px; border-radius:11px; border:1.5px solid var(--polyadic-line); background:var(--raise); color:var(--ink)}
  .numbtn:hover{border-color:var(--polyadic); background:var(--surface)}
  .numbtn:active{transform:translateY(1px)}
  .arm-more{display:flex; align-items:center; gap:9px; flex-wrap:wrap; margin-top:12px; border-top:1px dashed var(--polyadic-line); padding-top:12px}
  .arm-more .lbl{font-size:12.5px; color:var(--ink-soft)}
  .stepper{display:inline-flex; align-items:center; border:1px solid var(--line-strong); border-radius:10px; overflow:hidden; background:var(--raise)}
  .stepper button{appearance:none; border:0; background:transparent; color:var(--ink); width:38px; height:38px; font-size:20px; line-height:1; cursor:pointer}
  .stepper button:hover{background:var(--surface-2)}
  .stepper .sv{font-family:var(--mono); font-weight:600; min-width:32px; text-align:center; font-size:16px}
  .szcell{max-width:76px; min-width:60px; text-align:center; font-family:var(--mono); font-weight:600}

  /* Session clock */
  .sess-clock{display:flex; flex-direction:column; align-items:flex-end; gap:6px; flex:none}
  .clk-lbl{font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-faint); font-weight:600}
  .clock-face{font-family:var(--mono); font-size:22px; font-weight:600; letter-spacing:-.02em; font-variant-numeric:tabular-nums; display:flex; align-items:center; gap:8px}
  .clock-face .dot{width:8px; height:8px; border-radius:99px; background:var(--ink-faint); flex:none}
  .clock-face.run .dot{background:var(--ok); animation:pulse 1.7s ease-in-out infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.25}}

  /* Subgroup census */
  .census-head{font-weight:640; font-size:15.5px; letter-spacing:-.01em; display:flex; align-items:baseline; gap:8px; flex-wrap:wrap}
  .census-head .faint{font-weight:400; font-size:13px}
  .census-sum{display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap}
  .census-sum .big{font-size:15px; margin-top:3px}
  .census-sum .big b{font-family:var(--mono)}
  .subrows{display:flex; flex-direction:column; gap:8px; margin:13px 0 4px}
  .subrow{display:flex; align-items:center; gap:10px}
  .subrow .lab{font-size:13.5px; color:var(--ink-soft); min-width:98px; font-weight:550}
  .subrow input{width:88px; text-align:center; font-family:var(--mono); font-weight:600}
  .census-tot{font-size:13.5px; color:var(--ink-soft); margin-top:8px}
  .census-tot b{color:var(--ink); font-family:var(--mono)}

  /* Tally strip */
  .tallies{display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:var(--line); border:1px solid var(--line); border-radius:12px; overflow:hidden}
  @media (max-width:560px){ .tallies{grid-template-columns:repeat(2,1fr)} }
  .tally-cell{background:var(--surface); padding:11px 12px}
  .tally-cell .k{font-size:11px; color:var(--ink-faint); font-weight:600; letter-spacing:.02em}
  .tally-cell .v{font-family:var(--mono); font-size:23px; font-weight:600; letter-spacing:-.02em; margin-top:2px}
  .tally-cell.dyv .v{color:var(--dyadic)} .tally-cell.pov .v{color:var(--polyadic)}
  .tally-cell .sub{font-size:11px; color:var(--ink-soft); margin-top:1px}

  /* Buttons */
  .btn{
    appearance:none; font-family:inherit; font-size:14px; font-weight:600; cursor:pointer;
    border:1px solid var(--line-strong); background:var(--surface); color:var(--ink);
    border-radius:10px; padding:9px 14px; display:inline-flex; align-items:center; gap:7px; letter-spacing:-.01em;
    transition:background .12s ease, border-color .12s ease;
  }
  .btn:hover{background:var(--surface-2)}
  .btn.primary{background:var(--ink); color:var(--bg); border-color:var(--ink)}
  .btn.primary:hover{opacity:.92}
  .btn.accent{background:var(--dyadic); color:#fff; border-color:var(--dyadic)}
  .btn.accent:hover{opacity:.92}
  .btn.ghost{background:transparent}
  .btn.small{padding:6px 10px; font-size:13px; border-radius:8px}
  .btn.danger{color:var(--danger); border-color:var(--danger)}
  .btn.danger:hover{background:var(--danger-bg)}
  .btn:disabled{opacity:.45; cursor:not-allowed}
  .btn-row{display:flex; gap:8px; flex-wrap:wrap}

  /* Forms */
  label.fld{display:block; margin-bottom:12px}
  label.fld > span{display:block; font-size:12.5px; font-weight:600; color:var(--ink-soft); margin-bottom:5px}
  input[type=text], input[type=date], input[type=number], select, textarea{
    width:100%; font-family:inherit; font-size:15px; color:var(--ink);
    background:var(--raise); border:1px solid var(--line-strong); border-radius:9px; padding:9px 11px;
  }
  input:focus, select:focus, textarea:focus{outline:2px solid var(--dyadic); outline-offset:1px; border-color:var(--dyadic)}
  textarea{resize:vertical; min-height:52px}
  .form-2{display:grid; grid-template-columns:1fr 1fr; gap:0 12px}
  @media (max-width:560px){ .form-2{grid-template-columns:1fr} }

  /* Tables */
  .tbl-scroll{overflow-x:auto}
  table{border-collapse:collapse; width:100%; font-size:13.5px}
  th,td{text-align:left; padding:9px 11px; border-bottom:1px solid var(--line); white-space:nowrap}
  th{font-size:11.5px; text-transform:uppercase; letter-spacing:.04em; color:var(--ink-faint); font-weight:650; background:var(--surface-2); position:sticky; top:0}
  tbody tr:hover{background:var(--surface-2)}
  td.num, th.num{font-family:var(--mono); text-align:right; font-variant-numeric:tabular-nums}
  .pill{display:inline-block; padding:2px 8px; border-radius:99px; font-size:11.5px; font-weight:650}
  .pill.dy{background:var(--dyadic-bg); color:var(--dyadic)}
  .pill.po{background:var(--polyadic-bg); color:var(--polyadic)}
  td .mini{font-size:12px; color:var(--ink-soft)}
  tr.grp-total td{background:var(--surface-2); font-weight:700}
  .icell{border:1px solid var(--line); border-radius:7px; background:var(--raise); padding:5px 8px; font-size:12.5px; width:100%; min-width:120px}

  /* Sessions list */
  .sess-list{display:flex; flex-direction:column; gap:8px}
  .sess-item{display:flex; align-items:center; justify-content:space-between; gap:10px; padding:11px 13px; border:1px solid var(--line); border-radius:11px; background:var(--raise)}
  .sess-item .info .l1{font-weight:600; letter-spacing:-.01em}
  .sess-item .info .l1 .gp{color:var(--dyadic)}
  .sess-item .info .l2{font-size:12.5px; color:var(--ink-soft); font-family:var(--mono)}
  .sess-item.active{border-color:var(--dyadic); background:var(--dyadic-bg)}
  .row-actions{display:flex; gap:6px; flex-shrink:0}

  .icobtn{border:1px solid var(--line); background:var(--surface); color:var(--ink-soft); width:32px;height:32px;border-radius:8px;cursor:pointer;display:grid;place-items:center;font-size:14px}
  .icobtn:hover{color:var(--danger); border-color:var(--danger)}

  .hint{font-size:12.5px; color:var(--ink-soft); margin-top:8px; line-height:1.5}
  .divider{height:1px; background:var(--line); margin:16px 0}
  .kbd{font-family:var(--mono); font-size:12px; background:var(--surface-2); border:1px solid var(--line); border-radius:5px; padding:1px 6px}

  /* Toast */
  #toast{
    position:fixed; left:50%; bottom:22px; transform:translateX(-50%) translateY(20px);
    background:var(--ink); color:var(--bg); padding:10px 16px; border-radius:10px; font-size:14px; font-weight:600;
    box-shadow:var(--shadow); opacity:0; pointer-events:none; transition:opacity .2s ease, transform .2s ease; z-index:60; max-width:90vw;
  }
  #toast.show{opacity:1; transform:translateX(-50%) translateY(0)}
  #toast.err{background:var(--danger); color:#fff}

  /* Modal */
  #modal, #endmodal{position:fixed; inset:0; background:rgba(10,14,12,.5); display:none; place-items:center; z-index:70; padding:18px}
  #modal.show, #endmodal.show{display:grid}
  .modal-box{background:var(--surface); border:1px solid var(--line-strong); border-radius:14px; padding:18px; max-width:640px; width:100%; box-shadow:var(--shadow)}
  .modal-box h3{margin:0 0 6px; font-size:16px}
  .modal-box textarea{min-height:220px; font-family:var(--mono); font-size:12px; white-space:pre; overflow:auto}

  @media (prefers-reduced-motion:reduce){ *{animation:none !important; transition:none !important} }
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
</style>
</head>
<body>
<header class="top">
  <div class="top-inner">
    <div class="brand">
      <h1><span class="glyph" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="7" cy="8" r="2.4"/><circle cx="17" cy="8" r="2.4"/><circle cx="12" cy="16.5" r="2.4"/><path d="M9 8.6 15 8.6M8.2 10 11 14.6M15.8 10 13 14.6"/></svg>
      </span>Grooming Scan Sampler</h1>
      <button class="theme-btn" id="themeBtn" title="Toggle light / dark" aria-label="Toggle light or dark theme">◐</button>
    </div>
    <nav class="tabs" role="tablist" id="tabs">
      <button class="tab" role="tab" data-tab="record">Record</button>
      <button class="tab" role="tab" data-tab="summary">Summary</button>
      <button class="tab" role="tab" data-tab="data">Data &amp; export</button>
      <button class="tab" role="tab" data-tab="settings">Settings</button>
    </nav>
  </div>
</header>

<main class="wrap" id="app"></main>

<div id="toast" role="status" aria-live="polite"></div>
<div id="modal" role="dialog" aria-modal="true"><div class="modal-box">
  <h3 id="modalTitle">Export</h3>
  <p class="muted" id="modalMsg" style="font-size:13px;margin:0 0 10px"></p>
  <textarea id="modalText" readonly></textarea>
  <div class="btn-row" style="margin-top:12px;justify-content:flex-end">
    <button class="btn ghost" data-action="modal-close">Close</button>
    <button class="btn primary" data-action="modal-copy">Copy to clipboard</button>
  </div>
</div></div>

<div id="endmodal" role="dialog" aria-modal="true"><div class="modal-box">
  <h3>End this session?</h3>
  <p class="muted" style="font-size:13.5px;margin:0 0 16px;line-height:1.55">The <b>end-of-session subgroup census</b> hasn't been recorded yet. Logging how many subgroups are present and their sizes at the end keeps your census data complete.</p>
  <div class="btn-row" style="justify-content:flex-end;flex-wrap:wrap">
    <button class="btn ghost" data-action="end-cancel">Cancel</button>
    <button class="btn" data-action="end-anyway">End without census</button>
    <button class="btn primary" data-action="end-record">Record end census</button>
  </div>
</div></div>

<script>
"use strict";

/* ---------- SVG icons (taxonomy is encoded, not decorative) ---------- */
const ICON = {
  dyadic:'<svg viewBox="0 0 44 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><circle cx="32" cy="12" r="4.2"/><path d="M16.4 12 27.6 12"/></svg>',
  cluster:'<svg viewBox="0 0 44 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="22" cy="12" r="4"/><circle cx="7" cy="6" r="2.6"/><circle cx="7" cy="18" r="2.6"/><circle cx="37" cy="6" r="2.6"/><circle cx="37" cy="18" r="2.6"/><path d="M18.4 10 9.4 6.6M18.4 14 9.4 17.4M25.6 10 34.6 6.6M25.6 14 34.6 17.4"/></svg>',
  chain:'<svg viewBox="0 0 44 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="6" cy="12" r="3.4"/><circle cx="22" cy="12" r="3.4"/><circle cx="38" cy="12" r="3.4"/><path d="M9.4 12 18.6 12M25.4 12 34.6 12"/></svg>'
};

/* ---------- helpers ---------- */
const $ = s => document.querySelector(s);
const app = $("#app");
const uid = () => Math.random().toString(36).slice(2,9);
const todayStr = () => { const d=new Date(); return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0"); };
const nowISO = () => new Date().toISOString();
const fmtClock = iso => { try{ const d=new Date(iso); return String(d.getHours()).padStart(2,"0")+":"+String(d.getMinutes()).padStart(2,"0")+":"+String(d.getSeconds()).padStart(2,"0"); }catch(e){ return ""; } };
function esc(s){ return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
function mmss(t){ t=Math.max(0,Math.round(t)); return String(Math.floor(t/60)).padStart(2,"0")+":"+String(t%60).padStart(2,"0"); }
function fmtDur(sec){ sec=Math.max(0,Math.floor(sec)); const h=Math.floor(sec/3600), m=Math.floor((sec%3600)/60), s=sec%60; return String(h).padStart(2,"0")+":"+String(m).padStart(2,"0")+":"+String(s).padStart(2,"0"); }
const mean = (sum,n)=> n ? sum/n : null;
const fmtMean = m => m==null ? "—" : (Math.round(m*10)/10).toFixed(1);

/* ---------- state ---------- */
const LS_KEY = "grooming_scan_sampler_v1";
const defaultState = () => ({
  version:1,
  species:["Species 1","Species 2","Species 3"],
  groups:["","",""],
  defaultInterval:300,
  sessions:[],
  currentSessionId:null,
  activeTab:"record",
  theme:null
});
let state = defaultState();

function load(){
  try{
    const raw = localStorage.getItem(LS_KEY);
    if(raw){ const p = JSON.parse(raw); if(p && typeof p==="object"){ state = Object.assign(defaultState(), p);
      if(!Array.isArray(state.species)||state.species.length<3) state.species = defaultState().species;
      if(!Array.isArray(state.groups)||state.groups.length<3) state.groups = ["","",""];
      state.sessions.forEach(normSession);
      if(!Array.isArray(state.sessions)) state.sessions = [];
    } }
  }catch(e){ /* storage blocked or corrupt — run in memory */ }
}
function save(){
  try{ localStorage.setItem(LS_KEY, JSON.stringify(state)); }catch(e){}
}

/* ---------- theme ---------- */
function applyTheme(){
  if(state.theme==="light"||state.theme==="dark") document.documentElement.setAttribute("data-theme", state.theme);
  else document.documentElement.removeAttribute("data-theme");
}
function toggleTheme(){
  const cur = state.theme || (matchMedia("(prefers-color-scheme:dark)").matches ? "dark":"light");
  state.theme = cur==="dark" ? "light":"dark";
  applyTheme(); save();
}

/* ---------- session helpers ---------- */
function curSession(){ return state.sessions.find(s=>s.id===state.currentSessionId) || null; }
function groupLabelFor(species){
  const i = state.species.indexOf(species);
  const g = (i>=0 && state.groups[i]) ? String(state.groups[i]).trim() : "";
  return g || species;
}
function normSession(s){
  if(s.elapsedSec==null) s.elapsedSec=0;
  if(s.runningSince===undefined) s.runningSince=null;
  if(!s.startedAt) s.startedAt = (s.events[0] && s.events[0].time) || nowISO();
  if(!s.census) s.census = {start:{sizes:[],time:null}, end:{sizes:[],time:null}};
  if(!s.census.start) s.census.start = {sizes:[],time:null};
  if(!s.census.end) s.census.end = {sizes:[],time:null};
}
function sessElapsed(s){ return (s.elapsedSec||0) + (s.runningSince ? (Date.now()-Date.parse(s.runningSince))/1000 : 0); }
function sessResume(s){ if(s && !s.runningSince) s.runningSince = nowISO(); }
function sessPause(s){ if(s && s.runningSince){ s.elapsedSec = (s.elapsedSec||0) + (Date.now()-Date.parse(s.runningSince))/1000; s.runningSince = null; } }
function censusSub(c){ const sizes=(c&&c.sizes)||[]; return {n:sizes.length, total:sizes.reduce((a,b)=>a+(parseInt(b,10)||0),0), sizes}; }
function totals(sess){
  let dy=0, cl=0, ch=0, clSum=0, clN=0, chSum=0, chN=0;
  sess.events.forEach(e=>{
    if(e.type==="dyadic") dy++;
    else if(e.type==="polyadic"){
      const n = parseInt(e.size,10);
      if(e.subtype==="chain"){ ch++; if(n>=3){ chSum+=n; chN++; } }
      else { cl++; if(n>=3){ clSum+=n; clN++; } }
    }
  });
  return {dyadic:dy, cluster:cl, chain:ch, polyadic:cl+ch, events:sess.events.length, scans:sess.currentScan, clSum, clN, chSum, chN};
}
function groupSummary(){
  const map = new Map();
  state.sessions.forEach(s=>{
    if(!map.has(s.species)) map.set(s.species,{species:s.species,sessions:0,scans:0,events:0,dyadic:0,cluster:0,chain:0,clSum:0,clN:0,chSum:0,chN:0});
    const g = map.get(s.species), t = totals(s);
    g.sessions++; g.scans+=t.scans; g.events+=t.events; g.dyadic+=t.dyadic; g.cluster+=t.cluster; g.chain+=t.chain;
    g.clSum+=t.clSum; g.clN+=t.clN; g.chSum+=t.chSum; g.chN+=t.chN;
  });
  return [...map.values()].map(g=>{ g.group = groupLabelFor(g.species); return g; })
    .sort((a,b)=> String(a.species).localeCompare(b.species));
}

/* ---------- mutations ---------- */
let armed = null; // ephemeral: {subtype, size} while choosing a polyadic size
let censusEdit = {start:false, end:false}; // which census editors are open

function addEvent(type, subtype, size){
  const s = curSession(); if(!s) return;
  const ev = { id:uid(), scan:s.currentScan, time:nowISO(), type, subtype:subtype||null, participants:"", notes:"" };
  if(type==="polyadic") ev.size = Math.max(3, parseInt(size,10)||3);
  armed = null;
  s.events.push(ev);
  save(); render(); flashLog();
}
function removeEvent(id){
  const s = curSession(); if(!s) return;
  s.events = s.events.filter(e=>e.id!==id); save(); render();
}
function nextScan(){
  const s = curSession(); if(!s) return;
  s.currentScan++; save(); render();
  toast("Scan "+s.currentScan+" started");
}
function startSession(){
  const sp = $("#f-species").value;
  const ob = $("#f-observer").value.trim();
  const dt = $("#f-date").value || todayStr();
  const nt = $("#f-notes").value.trim();
  const s = { id:uid(), species:sp, group:groupLabelFor(sp), observer:ob, date:dt, notes:nt, currentScan:1, events:[],
    startedAt:nowISO(), elapsedSec:0, runningSince:nowISO(),
    census:{start:{sizes:[],time:null}, end:{sizes:[],time:null}} };
  state.sessions.unshift(s); state.currentSessionId=s.id;
  censusEdit = {start:true, end:false};
  save(); render();
  toast("Session started");
}
function resumeSession(id){
  state.currentSessionId=id; const s=curSession();
  if(s){ normSession(s); sessResume(s); censusEdit={start:s.census.start.sizes.length===0, end:false}; }
  save(); render();
}
function endSession(){ const s=curSession(); if(s) sessPause(s); state.currentSessionId=null; save(); render(); }
function finishSession(){
  const s=curSession(); if(!s) return;
  if(((s.census.end&&s.census.end.sizes)||[]).length===0){ document.getElementById("endmodal").classList.add("show"); return; }
  endSession(); toast("Session ended");
}
function deleteSession(id){
  const s = state.sessions.find(x=>x.id===id); if(!s) return;
  if(!confirm("Delete this session for "+s.species+" · "+s.group+"?\nThis removes "+s.events.length+" grooming record(s) and cannot be undone.")) return;
  state.sessions = state.sessions.filter(x=>x.id!==id);
  if(state.currentSessionId===id) state.currentSessionId=null;
  save(); render();
}
function editField(id, field, val){
  for(const s of state.sessions){ const e = s.events.find(e=>e.id===id); if(e){
    if(field==="size") e.size = Math.max(3, parseInt(val,10)||3); else e[field]=val;
    save(); return; } }
}

/* ============================ RENDER ============================ */
function render(){
  document.querySelectorAll(".tab").forEach(t=> t.setAttribute("aria-selected", String(t.dataset.tab===state.activeTab)));
  if(state.activeTab==="record") renderRecord();
  else if(state.activeTab==="summary") renderSummary();
  else if(state.activeTab==="data") renderData();
  else renderSettings();
  if(state.activeTab==="record") Timer.mount();
}

/* ---------- Record ---------- */
