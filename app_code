/* ============================ TIMER ============================ */
const Timer = (() => {
  let intervalSec = state.defaultInterval, remaining = state.defaultInterval, running=false, autoAdvance=false, handle=null;
  function mount(){
    const panel = $("#timerPanel"); if(!panel) return;
    panel.innerHTML = `
      <div class="timer-head">
        <div class="timer-face" id="tface">${mmss(remaining)}</div>
        <div class="btn-row">
          <button class="btn small" data-action="timer-toggle">${running?"Pause":"Start"} timer</button>
          <button class="btn small ghost" data-action="timer-reset">Reset</button>
        </div>
      </div>
      <div class="timer-bar"><i id="tbar" style="width:${intervalSec?100*remaining/intervalSec:0}%"></i></div>
      <div class="timer-row">
        <span class="timer-set">Interval <input type="number" min="5" step="5" id="tinterval" value="${intervalSec}"> s</span>
        <label class="chk"><input type="checkbox" id="tauto" ${autoAdvance?"checked":""}> auto-advance scan</label>
      </div>`;
    panel.querySelector("#tinterval").addEventListener("change", e=>{
      const v = Math.max(5, parseInt(e.target.value,10)||intervalSec);
      intervalSec=v; if(!running){ remaining=v; paint(); }
    });
    panel.querySelector("#tauto").addEventListener("change", e=> autoAdvance=e.target.checked);
  }
  function paint(){
    const f=$("#tface"), b=$("#tbar");
    if(f) f.textContent = mmss(remaining);
    if(b) b.style.width = (intervalSec?100*Math.max(0,remaining)/intervalSec:0)+"%";
  }
  function tick(){
    remaining--; paint();
    if(remaining<=0){
      beep(); const card=$("#timerPanel")?.closest(".card"); if(card){ card.classList.remove("due"); void card.offsetWidth; card.classList.add("due"); }
      if(autoAdvance){ remaining=intervalSec; nextScan(); }
      else { running=false; if(handle){clearInterval(handle);handle=null;} remaining=0; toast("Scan due — advance when ready"); mountSafe(); }
    }
  }
  function toggle(){
    if(running){ running=false; if(handle){clearInterval(handle);handle=null;} }
    else { if(remaining<=0) remaining=intervalSec; running=true; handle=setInterval(tick,1000); }
    mountSafe();
  }
  function reset(){ remaining=intervalSec; if(!running){} paint(); mountSafe(); }
  function mountSafe(){ if(state.activeTab==="record" && curSession()) mount(); }
  function setDefault(v){ intervalSec=v; if(!running) remaining=v; }
  return { mount, toggle, reset, setDefault, mountSafe };
})();

function beep(){
  try{
    const Ctx = window.AudioContext||window.webkitAudioContext; if(!Ctx) return;
    const ctx = new Ctx(); const o=ctx.createOscillator(), g=ctx.createGain();
    o.type="sine"; o.frequency.value=880; o.connect(g); g.connect(ctx.destination);
    g.gain.setValueAtTime(0.001,ctx.currentTime); g.gain.exponentialRampToValueAtTime(0.25,ctx.currentTime+0.02);
    g.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+0.5);
    o.start(); o.stop(ctx.currentTime+0.5); setTimeout(()=>ctx.close(),700);
  }catch(e){}
}
function flashLog(){ const c=$("#chips"); if(c){ /* chip pop handles it */ } }

/* ============================ EXPORT ============================ */
function csvCell(v){ v = v==null?"":String(v); return /[",\n\r]/.test(v) ? '"'+v.replace(/"/g,'""')+'"' : v; }
function toCSV(rows){ return rows.map(r=>r.map(csvCell).join(",")).join("\r\n"); }

function eventsCSV(){
  const head = ["session_id","species","group","observer","date","scan_number","event_time","event_id","grooming_type","polyadic_subtype","n_individuals","participants","notes"];
  const rows = [head];
  state.sessions.forEach(s=> s.events.forEach(e=>{
    const n = e.type==="dyadic" ? 2 : (parseInt(e.size,10)||"");
    rows.push([s.id,s.species,s.group,s.observer,s.date,e.scan,e.time,e.id,e.type,e.type==="polyadic"?(e.subtype||"cluster"):"",n,e.participants,e.notes]);
  }));
  return toCSV(rows);
}
function summaryCSV(){
  const head = ["species","group","sessions","total_scans","total_bouts","dyadic","polyadic","polyadic_cluster","polyadic_chain","mean_cluster_size","mean_chain_size"];
  const rows = [head];
  groupSummary().forEach(g=>{
    const cm = g.clN ? Math.round(g.clSum/g.clN*100)/100 : "";
    const hm = g.chN ? Math.round(g.chSum/g.chN*100)/100 : "";
    rows.push([g.species,g.group,g.sessions,g.scans,g.events,g.dyadic,g.cluster+g.chain,g.cluster,g.chain,cm,hm]);
  });
  return toCSV(rows);
}
function sessionsCSV(){
  const head = ["session_id","species","group","observer","date","started_at","duration_sec","duration_hms","grooming_scans","dyadic","polyadic","polyadic_cluster","polyadic_chain","start_n_subgroups","start_individuals","end_n_subgroups","end_individuals"];
  const rows = [head];
  state.sessions.forEach(s=>{
    const t = totals(s), dur = Math.round(sessElapsed(s));
    const cs = censusSub(s.census&&s.census.start), ce = censusSub(s.census&&s.census.end);
    rows.push([s.id,s.species,s.group,s.observer,s.date,s.startedAt||"",dur,fmtDur(dur),t.scans,t.dyadic,t.polyadic,t.cluster,t.chain,cs.n,cs.total,ce.n,ce.total]);
  });
  return toCSV(rows);
}
function censusCSV(){
  const head = ["session_id","species","group","date","phase","census_time","n_subgroups","subgroup_index","subgroup_size"];
  const rows = [head];
  state.sessions.forEach(s=>{
    ["start","end"].forEach(ph=>{
      const c = s.census && s.census[ph]; const sizes = (c&&c.sizes)||[];
      sizes.forEach((sz,i)=> rows.push([s.id,s.species,s.group,s.date,ph,(c&&c.time)||"",sizes.length,i+1,sz]));
    });
  });
  return toCSV(rows);
}

async function offerFile(filename, text){
  // 1) claude.ai hosted downloads capability, when present
  try{
    if(window.claude && typeof window.claude.use==="function"){
      const dl = await window.claude.use("downloads");
      if(dl){
        try{ await dl.save({filename, data:text}); toast("Saved "+filename); return; }
        catch(err){ if(err && err.code==="declined"){ return; } /* else fall through */ }
      }
    }
  }catch(e){}
  // 2) standard blob download (works when run locally / most hosts)
  try{
    const blob = new Blob([text], {type:"text/plain;charset=utf-8"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a"); a.href=url; a.download=filename;
    document.body.appendChild(a); a.click();
    setTimeout(()=>{ URL.revokeObjectURL(url); a.remove(); }, 120);
    toast("Downloaded "+filename); return;
  }catch(e){}
  // 3) last resort — show text so nothing is ever trapped
  showModal(filename, "Copy this and save it as "+filename, text);
}
function stamp(){ return todayStr().replace(/-/g,""); }

/* ============================ MODAL / TOAST ============================ */
let toastTimer=null;
function toast(msg, kind){
  const t=$("#toast"); t.textContent=msg; t.className = kind==="err"?"err show":"show";
  clearTimeout(toastTimer); toastTimer=setTimeout(()=> t.classList.remove("show"), 2200);
}
let modalText="";
function showModal(title,msg,text){
  modalText=text; $("#modalTitle").textContent=title; $("#modalMsg").textContent=msg||"";
  $("#modalText").value=text; $("#modal").classList.add("show");
}
function closeModal(){ $("#modal").classList.remove("show"); }
async function copyModal(){
  try{ await navigator.clipboard.writeText(modalText); toast("Copied"); }
  catch(e){ const ta=$("#modalText"); ta.focus(); ta.select(); try{document.execCommand("copy"); toast("Copied");}catch(_){ toast("Press Ctrl/Cmd-C","err"); } }
}

/* ============================ EVENTS ============================ */
document.addEventListener("click", e=>{
  if(e.target.id==="endmodal"){ e.target.classList.remove("show"); return; }
  if(e.target.id==="modal"){ e.target.classList.remove("show"); return; }
  const tab = e.target.closest(".tab");
  if(tab){ state.activeTab=tab.dataset.tab; save(); render(); return; }
  if(e.target.closest("#themeBtn")){ toggleTheme(); return; }

  const el = e.target.closest("[data-action]"); if(!el) return;
  const a = el.dataset.action;
  switch(a){
    case "log": addEvent(el.dataset.type, el.dataset.sub||null); break;
    case "arm": armed = {subtype:el.dataset.sub, size:(armed&&armed.subtype===el.dataset.sub?armed.size:3)}; render(); break;
    case "arm-log": addEvent("polyadic", armed?armed.subtype:el.dataset.sub, el.dataset.size); break;
    case "arm-inc": if(armed){ armed.size++; render(); } break;
    case "arm-dec": if(armed){ armed.size=Math.max(3,armed.size-1); render(); } break;
    case "arm-cancel": armed=null; render(); break;
    case "rm": removeEvent(el.dataset.id); break;
    case "next-scan": nextScan(); break;
    case "sess-toggle": { const s=curSession(); if(s){ if(s.runningSince) sessPause(s); else sessResume(s); save(); render(); } break; }
    case "census-edit": censusEdit[el.dataset.phase]=true; render(); break;
    case "census-done": censusEdit[el.dataset.phase]=false; render(); break;
    case "census-add": { const s=curSession(); if(s){ const c=s.census[el.dataset.phase]; c.sizes.push(1); if(!c.time) c.time=nowISO(); censusEdit[el.dataset.phase]=true; save(); render(); } break; }
    case "census-del": { const s=curSession(); if(s){ s.census[el.dataset.phase].sizes.splice(+el.dataset.idx,1); save(); render(); } break; }
    case "start-session": startSession(); break;
    case "end-session": endSession(); break;
    case "end-session": finishSession(); break;
    case "switch-session": endSession(); break;
    case "end-cancel": document.getElementById("endmodal").classList.remove("show"); break;
    case "end-anyway": document.getElementById("endmodal").classList.remove("show"); endSession(); toast("Session ended"); break;
    case "end-record": {
      document.getElementById("endmodal").classList.remove("show");
      censusEdit.end=true; render();
      setTimeout(()=>{ const el=document.getElementById("endCensus"); if(el) el.scrollIntoView({behavior:"smooth",block:"center"}); }, 60);
      break;
    }
    case "resume": resumeSession(el.dataset.id); break;
    case "del-session": deleteSession(el.dataset.id); break;
    case "goto-settings": state.activeTab="settings"; save(); render(); break;
    case "timer-toggle": Timer.toggle(); break;
    case "timer-reset": Timer.reset(); break;
    case "save-species": {
      const v=[0,1,2].map(i=> ($("#sp-"+i).value||"").trim());
      state.species = v.map((x,i)=> x || ("Species "+(i+1)));
      state.groups = [0,1,2].map(i=> ($("#gp-"+i).value||"").trim());
      save(); toast("Saved"); render(); break;
    }
    case "save-interval": {
      const v=Math.max(5, parseInt($("#def-interval").value,10)||state.defaultInterval);
      state.defaultInterval=v; Timer.setDefault(v); save(); toast("Interval saved"); break;
    }
    case "export-events": offerFile("grooming_bouts_"+stamp()+".csv", eventsCSV()); break;
    case "export-sessions": offerFile("grooming_sessions_"+stamp()+".csv", sessionsCSV()); break;
    case "export-summary": offerFile("grooming_species_summary_"+stamp()+".csv", summaryCSV()); break;
    case "export-census": offerFile("grooming_subgroup_census_"+stamp()+".csv", censusCSV()); break;
    case "export-backup": offerFile("grooming_backup_"+stamp()+".json", JSON.stringify(state,null,2)); break;
    case "clear-all":
      if(confirm("Erase ALL sessions and bouts from this browser? This cannot be undone.\nExport a backup first if you want to keep the data.")){
        state = defaultState(); save(); toast("All data erased"); render();
      }
      break;
    case "modal-close": closeModal(); break;
    case "modal-copy": copyModal(); break;
  }
});

document.addEventListener("change", e=>{
  const cen = e.target.closest("input[data-census]");
  if(cen){ const s=curSession(); if(s){ const arr=s.census[cen.dataset.census].sizes; arr[+cen.dataset.idx]=Math.max(1,parseInt(cen.value,10)||1); save(); render(); } return; }
  const inp = e.target.closest("input[data-edit]");
  if(inp){ editField(inp.dataset.id, inp.dataset.edit, inp.value); if(inp.dataset.edit==="size") render(); return; }
  const file = e.target.closest("#import-file");
  if(file && file.files && file.files[0]){
    const reader = new FileReader();
    reader.onload = ()=>{
      try{
        const p = JSON.parse(reader.result);
        if(!p || typeof p!=="object" || !Array.isArray(p.sessions)) throw new Error("bad");
        if(!confirm("Replace all current data with this backup? "+p.sessions.length+" session(s) will be loaded.")) return;
        state = Object.assign(defaultState(), p); state.sessions.forEach(normSession); state.currentSessionId=null; applyTheme(); save(); render(); toast("Backup restored");
      }catch(err){ toast("That file isn't a valid backup","err"); }
    };
    reader.readAsText(file.files[0]);
  }
});

/* ============================ INIT ============================ */
load(); applyTheme(); Timer.setDefault(state.defaultInterval);
if(!["record","summary","data","settings"].includes(state.activeTab)) state.activeTab="record";
render();

// live whole-session clock (updates the display only; state math is timestamp-based)
setInterval(()=>{
  const el = document.getElementById("sessClock"); if(!el) return;
  const s = curSession(); if(!s || !s.runningSince) return;
  el.textContent = fmtDur(sessElapsed(s));
}, 1000);
</script>
